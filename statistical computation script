#!/bin/bash

echo "Protocol Performance Summary"
echo "========================================"

for file in experiments/*/*.txt
do
    echo
    echo "File: $file"

    mean=$(awk '{sum+=$2} END {print sum/NR}' $file)

    median=$(awk '{print $2}' $file | sort -n | awk '{a[NR]=$1} END {print a[int(NR/2)]}')

    std=$(awk '{x[NR]=$2; sum+=$2} END {mean=sum/NR; for(i=1;i<=NR;i++) s+=(x[i]-mean)^2; print sqrt(s/NR)}' $file)

    p95=$(awk '{print $2}' $file | sort -n | awk '{a[NR]=$1} END {print a[int(NR*0.95)]}')

    printf "Mean: %.4f\n" $mean
    printf "Median: %.4f\n" $median
    printf "Std Dev: %.4f\n" $std
    printf "95th percentile: %.4f\n" $p95

done
